# Copy this to .env for local development, but never commit the real file.
# docker compose reads .env automatically.
# Generate a strong value with: openssl rand -hex 32

# Password gate (same value you set on Render)
APP_PASSWORD=replace-with-your-password

# HMAC session signing secret
SESSION_SECRET=replace-with-a-long-random-secret

# OpenRouter key for Deep Dive (optional locally)
OPENROUTER_API_KEY=

# 1 = allow disk writes (dev only); 0 = read-only (matches Render)
ALLOW_RW=0

# HTTP port
PORT=4173